<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>filmHUB | Script-to-Storyboard Studio</title>
<style>
:root {
  --ink: #060911;
  --panel: #0A0F1D;
  --card: #0D1424;
  --line: #1B2436;
  --line2: #26344E;
  --tx: #E6EBF2;
  --mu: #8794A6;
  --gold: #E5A93C;
  --amber: #F0A30A;
  --cyan: #00ABA9;
  --lime: #88C13F;
  --red: #E51400;
  --fd: 'Impact', 'Arial Narrow Bold', sans-serif;
  --fb: system-ui, -apple-system, sans-serif;
  --fm: 'Courier Prime', 'Courier New', Courier, monospace;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--ink);
  color: var(--tx);
  font-family: var(--fb);
  font-size: 13.5px;
  line-height: 1.5;
}
header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--panel);
  border-bottom: 1px solid var(--line);
  padding: 8px 18px;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.brand {
  font-family: var(--fd);
  font-size: 22px;
  letter-spacing: .05em;
  text-transform: uppercase;
}
.brand b { color: var(--gold); font-weight: normal; }
.badge {
  font-family: var(--fm);
  font-size: 9px;
  letter-spacing: .12em;
  background: rgba(229,169,60,.12);
  border: 1px solid rgba(229,169,60,.4);
  color: var(--gold);
  padding: 2px 6px;
  border-radius: 3px;
}
.top-tools {
  margin-left: auto;
  display: flex;
  gap: 8px;
  align-items: center;
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #131A28;
  border: 1px solid var(--line2);
  color: var(--tx);
  padding: 6px 11px;
  border-radius: 5px;
  cursor: pointer;
  font-weight: 600;
  font-size: 12px;
  transition: .15s;
}
.btn:hover { background: #1B2436; color: #fff; }
.btn.pri { background: linear-gradient(135deg, var(--amber), #C98708); color: #060911; border: none; }
.btn.sm { padding: 4px 8px; font-size: 11px; }

main {
  max-width: 1400px;
  margin: 0 auto;
  padding: 20px 16px 80px;
}
.panel-grid {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 16px;
}
@media(max-width: 900px) {
  .panel-grid { grid-template-columns: 1fr; }
}

.box {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 14px;
}
.box h3 {
  margin: 0 0 10px;
  font-size: 13px;
  font-family: var(--fm);
  letter-spacing: .08em;
  color: var(--mu);
  text-transform: uppercase;
}
textarea {
  width: 100%;
  background: var(--panel);
  border: 1px solid var(--line2);
  color: var(--tx);
  border-radius: 6px;
  padding: 10px;
  font-family: var(--fm);
  font-size: 12px;
  line-height: 1.4;
  outline: none;
  resize: vertical;
}
textarea:focus { border-color: var(--gold); }

/* Scene Shot List & Cards */
.scene-block {
  margin-bottom: 24px;
  border: 1px solid var(--line2);
  border-radius: 8px;
  background: #090E1A;
  overflow: hidden;
}
.scene-header {
  padding: 10px 14px;
  background: #0D1628;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.scene-title {
  font-family: var(--fd);
  font-size: 16px;
  color: var(--gold);
  letter-spacing: .04em;
  margin: 0;
}
.shot-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 12px;
  padding: 14px;
}
.shot-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 6px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.shot-card-header {
  padding: 6px 10px;
  background: #0A0F1D;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--line);
}
.shot-num {
  font-family: var(--fm);
  font-size: 11px;
  color: var(--amber);
  font-weight: 700;
}
.shot-type-badge {
  font-family: var(--fm);
  font-size: 10px;
  color: var(--cyan);
  background: rgba(0,171,169,.12);
  border: 1px solid rgba(0,171,169,.35);
  padding: 1px 6px;
  border-radius: 3px;
  cursor: pointer;
}
.frame-wrap {
  width: 100%;
  aspect-ratio: 16 / 8.5;
  background: #030509;
  position: relative;
  overflow: hidden;
}
.frame-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.frame-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  cursor: crosshair;
}
.shot-body {
  padding: 10px;
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.shot-line {
  font-size: 11.5px;
  color: #CBD6E2;
  line-height: 1.35;
  margin: 0;
}
.shot-subtext {
  font-family: var(--fm);
  font-size: 10.5px;
  color: var(--gold);
}
.shot-footer {
  margin-top: auto;
  padding-top: 6px;
  border-top: 1px solid var(--line);
  display: flex;
  gap: 6px;
  justify-content: flex-end;
}

/* Modals */
dialog {
  border: 0;
  padding: 0;
  background: transparent;
}
dialog::backdrop {
  background: rgba(3,6,12,.85);
}
.dlg {
  width: 100%;
  max-width: 620px;
  background: #0D1421;
  border: 1px solid var(--line2);
  border-top: 3px solid var(--gold);
  border-radius: 8px;
  overflow: hidden;
  color: var(--tx);
}
.dlg-h {
  padding: 12px 16px;
  border-bottom: 1px solid var(--line);
  background: #0A0F1D;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dlg-b {
  padding: 16px;
  max-height: 70vh;
  overflow-y: auto;
}
.dlg-f {
  padding: 10px 16px;
  border-top: 1px solid var(--line);
  background: #0A0F1D;
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}
.lib-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.lib-thumb {
  border: 1px solid var(--line2);
  border-radius: 5px;
  overflow: hidden;
  background: #070B14;
  cursor: pointer;
  text-align: center;
  padding-bottom: 6px;
}
.lib-thumb:hover {
  border-color: var(--gold);
  filter: brightness(1.1);
}
.lib-thumb img {
  width: 100%;
  aspect-ratio: 16 / 8.5;
  object-fit: cover;
  display: block;
}
.lib-thumb span {
  display: block;
  font-family: var(--fm);
  font-size: 10px;
  margin-top: 5px;
  color: #C6D1DC;
}

/* Print Sheet */
@media print {
  body > * { display: none !important; }
  #printSheet { display: block !important; background: #fff !important; color: #000 !important; }
  .p-page { page-break-after: always; padding: 20px; }
  .p-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .p-card { border: 1px solid #999; border-radius: 4px; overflow: hidden; }
  .p-card img { width: 100%; aspect-ratio: 16 / 8.5; object-fit: cover; }
  .p-desc { padding: 6px; font-size: 10px; font-family: monospace; }
}
#printSheet { display: none; }
</style>
</head>
