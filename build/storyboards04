let activeTargetShot = null;
let storyboardData = [];

// Semantic Shot Classifier using Scene Text
function classifyShot(text, prevType, characterCount) {
  const t = text.toLowerCase();

  // 1. Specific insert props / hands[cite: 18]
  if (/\b(phone|key|keys|gun|display|analog|glyphs|screen|letter|watch|dial|wallet|knife|pill|badge)\b/i.test(t)) {
    return 'insert';
  }
  // 2. Low angle / feet / floor / ground level[cite: 9]
  if (/\b(floor|boots|feet|footsteps|shoes|pavement|asphalt|ground|curb|grass|dirt|treads)\b/i.test(t)) {
    return 'ground';
  }
  // 3. Stunts, scrambling, low struggle[cite: 10]
  if (/\b(crouch|crouching|crawl|crawling|scramble|scrambles|tackle|dives|lunges|scramble|knee)\b/i.test(t)) {
    return 'knee';
  }
  // 4. Weapons, holsters, standoff[cite: 11]
  if (/\b(holster|belt|waist|pocket|draws|grip|standoff|unholster)\b/i.test(t)) {
    return 'hip';
  }
  // 5. Overhead perspective[cite: 14]
  if (/\b(ceiling|overhead|above|down on|lying|fallen|dead|silhouette from high|spiral)\b/i.test(t)) {
    return 'overhead';
  }
  // 6. Extreme psychological tension, disorientation, shock[cite: 15]
  if (/\b(dread|pulse|alien|flicker|mimicking|strange|terror|tremble|rumble|shakes|spinning)\b/i.test(t)) {
    return 'dutch';
  }
  // 7. Multiple characters or crowd[cite: 16]
  if (/\b(crowd|group|officers|men|agents|everyone|they|surround|stand around)\b/i.test(t) || characterCount >= 3) {
    return 'ha';
  }
  // 8. Intimate or high emotion close proximity[cite: 12]
  if (/\b(kiss|whisper|tears|embrace|clutch|ear|mouth|eyes dart|breathes shallow)\b/i.test(t)) {
    return 'shoulder';
  }
  // 9. Two-person dialogue exchange[cite: 17]
  if (characterCount === 2 && prevType !== 'ots') {
    return 'ots';
  }
  // Default to Eye Level dialogue / standard shot[cite: 13]
  return 'eye';
}

// Robust Screenplay Parser
function parseScreenplay(raw) {
  const lines = raw.split(/\r?\n/);
  const scenes = [];
  let currentScene = null;
  let currentSpeechChar = null;

  lines.forEach((line) => {
    const trimmed = line.trim();
    if (!trimmed) return;

    // Detect Scene Heading
    if (/^\s*(?:INT|EXT|EST|I\/E)[\.\s]/i.test(trimmed)) {
      currentScene = {
        heading: trimmed.toUpperCase(),
        shots: []
      };
      scenes.push(currentScene);
      currentSpeechChar = null;
      return;
    }

    if (!currentScene) {
      currentScene = { heading: "INT. SCENE 1 - DAY", shots: [] };
      scenes.push(currentScene);
    }

    // Detect Character Cue
    if (trimmed === trimmed.toUpperCase() && trimmed.length < 35 && !/[.,!?]$/.test(trimmed)) {
      currentSpeechChar = trimmed.replace(/\s*\(.*?\)/, '');
      return;
    }

    // Dialogue Beat
    if (currentSpeechChar && !/^[\[\(]/.test(trimmed)) {
      currentScene.shots.push({
        type: 'dialogue',
        character: currentSpeechChar,
        text: trimmed
      });
      currentSpeechChar = null;
      return;
    }

    // Action Narrative Beat
    currentScene.shots.push({
      type: 'action',
      text: trimmed
    });
    currentSpeechChar = null;
  });

  return scenes;
}

// Generate Storyboard Data Structure
function generateStoryboard() {
  const raw = document.getElementById('scriptInput').value;
  if (!raw.trim()) return;

  const parsedScenes = parseScreenplay(raw);
  storyboardData = [];

  parsedScenes.forEach((sc, sIdx) => {
    const sceneShots = [];
    let prevShotKey = 'eye';

    sc.shots.forEach((shot, shIdx) => {
      // Condense very short dialogue/action bursts so we generate clear beats
      const key = classifyShot(shot.text, prevShotKey, 1);
      prevShotKey = key;

      sceneShots.push({
        id: `${sIdx + 1}.${shIdx + 1}`,
        key: key,
        title: SHOT_LIBRARY[key].name,
        action: shot.type === 'action' ? shot.text : `[${shot.character}] "${shot.text}"`,
        note: shot.type === 'dialogue' ? `Dialogue: ${shot.character}` : `Visual Setup`
      });
    });

    storyboardData.push({
      heading: sc.heading,
      shots: sceneShots
    });
  });

  renderStoryboard();
}

function renderStoryboard() {
  const container = document.getElementById('storyboardContainer');
  if (!storyboardData.length) {
    container.innerHTML = `<div style="padding: 20px; color: var(--mu);">No shots found in script.</div>`;
    return;
  }

  container.innerHTML = storyboardData.map((sc, sIdx) => `
    <div class="scene-block">
      <div class="scene-header">
        <h3 class="scene-title">SCENE ${sIdx + 1}: ${sc.heading}</h3>
        <span class="badge">${sc.shots.length} SHOTS</span>
      </div>
      <div class="shot-grid">
        ${sc.shots.map((sh, shIdx) => `
          <div class="shot-card">
            <div class="shot-card-header">
              <span class="shot-num">SHOT ${sh.id}</span>
              <span class="shot-type-badge" onclick="openPicker(${sIdx}, ${shIdx})">${sh.title} ▾</span>
            </div>
            <div class="frame-wrap" id="wrap_${sIdx}_${shIdx}">
              ${SHOT_LIBRARY[sh.key].svg}
              <canvas class="frame-canvas" id="cv_${sIdx}_${shIdx}" width="425" height="225"></canvas>
            </div>
            <div class="shot-body">
              <p class="shot-line">${sh.action}</p>
              <div class="shot-subtext">${sh.note}</div>
              <div class="shot-footer">
                <button class="btn sm" onclick="clearCanvas(${sIdx},${shIdx})">Clear Sketch</button>
                <button class="btn sm" onclick="openPicker(${sIdx},${shIdx})">Change Shot</button>
              </div>
            </div>
          </div>
        `).join('')}
      </div>
    </div>
  `).join('');

  // Wire canvas drawing on each shot
  storyboardData.forEach((sc, sIdx) => {
    sc.shots.forEach((sh, shIdx) => {
      wireDrawing(sIdx, shIdx);
    });
  });
}

function wireDrawing(sIdx, shIdx) {
  const cv = document.getElementById(`cv_${sIdx}_${shIdx}`);
  if (!cv) return;
  const ctx = cv.getContext('2d');
  let drawing = false, last = null;

  ctx.lineWidth = 2.5;
  ctx.strokeStyle = '#E5A93C';
  ctx.lineCap = 'round';

  function pos(e) {
    const r = cv.getBoundingClientRect();
    return {
      x: (e.clientX - r.left) * (cv.width / r.width),
      y: (e.clientY - r.top) * (cv.height / r.height)
    };
  }

  cv.onmousedown = (e) => { drawing = true; last = pos(e); };
  cv.onmousemove = (e) => {
    if (!drawing) return;
    const p = pos(e);
    ctx.beginPath();
    ctx.moveTo(last.x, last.y);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
    last = p;
  };
  window.addEventListener('mouseup', () => { drawing = false; });
}

function clearCanvas(sIdx, shIdx) {
  const cv = document.getElementById(`cv_${sIdx}_${shIdx}`);
  if (cv) cv.getContext('2d').clearRect(0, 0, cv.width, cv.height);
}

// Modal Selector
function openPicker(sIdx, shIdx) {
  activeTargetShot = { sIdx, shIdx };
  const grid = document.getElementById('pickerGrid');
  grid.innerHTML = Object.keys(SHOT_LIBRARY).map((k) => `
    <div class="lib-thumb" onclick="assignShotFraming('${k}')">
      ${SHOT_LIBRARY[k].svg}
      <span>${SHOT_LIBRARY[k].name}</span>
    </div>
  `).join('');
  document.getElementById('pickerModal').showModal();
}

function assignShotFraming(key) {
  if (!activeTargetShot) return;
  const { sIdx, shIdx } = activeTargetShot;
  storyboardData[sIdx].shots[shIdx].key = key;
  storyboardData[sIdx].shots[shIdx].title = SHOT_LIBRARY[key].name;
  document.getElementById('pickerModal').close();
  renderStoryboard();
}

// CSV Export
document.getElementById('btnExportCSV').onclick = () => {
  if (!storyboardData.length) return alert('Generate a storyboard first.');
  let csv = 'Scene,Shot,Type,Description,Notes\n';
  storyboardData.forEach((sc, sIdx) => {
    sc.shots.forEach((sh) => {
      csv += `"${sc.heading}","${sh.id}","${sh.title}","${sh.action.replace(/"/g, '""')}","${sh.note}"\n`;
    });
  });
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'production_storyboard_shotlist.csv';
  a.click();
};

// Print / PDF Sheet
document.getElementById('btnPrintSheet').onclick = () => {
  if (!storyboardData.length) return alert('Generate a storyboard first.');
  const pSheet = document.getElementById('printSheet');
  pSheet.innerHTML = storyboardData.map((sc, sIdx) => `
    <div class="p-page">
      <h2 style="font-family:sans-serif; margin-bottom:14px;">SCENE ${sIdx + 1}: ${sc.heading}</h2>
      <div class="p-grid">
        ${sc.shots.map((sh) => `
          <div class="p-card">
            ${SHOT_LIBRARY[sh.key].svg}
            <div class="p-desc">
              <b>SHOT ${sh.id} &middot; ${sh.title}</b><br>${sh.action}
            </div>
          </div>
        `).join('')}
      </div>
    </div>
  `).join('');
  window.print();
};

