<header>
  <div class="brand">film<b>HUB</b> Storyboard Studio</div>
  <span class="badge">SCRIPT-TO-STORYBOARD ENGINE</span>
  <div class="top-tools">
    <button class="btn sm" id="btnExportCSV">Export Shot List (.CSV)</button>
    <button class="btn sm" id="btnPrintSheet">Print / PDF Sheet</button>
  </div>
</header>

<main>
  <div class="panel-grid">
    <!-- Left: Script Input & Controls -->
    <div class="box">
      <h3>1. Paste Screenplay</h3>
      <textarea id="scriptInput" rows="18" placeholder="Paste your screenplay scene or fountain text here..."></textarea>
      <div style="display: flex; gap: 8px; margin-top: 10px;">
        <button class="btn pri" id="btnParse" style="flex: 1;">Generate Storyboard</button>
        <button class="btn" id="btnLoadSample">Sample Script</button>
      </div>
      
      <div style="margin-top: 18px; border-top: 1px solid var(--line); padding-top: 14px;">
        <h3>Parsing Rules Loaded</h3>
        <ul style="font-size: 11.5px; color: var(--mu); padding-left: 18px; margin: 0; line-height: 1.6;">
          <li><b>Ground Level:</b> Feet, boots, asphalt, shoes, floor, crawling</li>
          <li><b>Knee Level:</b> Dodging, scrambling, lunging, crouching, diving, low actions</li>
          <li><b>Hip Level:</b> Holsters, weapons, draw, belt, pocket, standoff</li>
          <li><b>Shoulder Level:</b> Intimate dialogue, kissing, embrace, whispered reactions</li>
          <li><b>Eye Level:</b> Direct confrontation, formal dialogue, interviews[cite: 13]</li>
          <li><b>Overhead Shot:</b> Fallen bodies, crime scenes, ceilings, lights from above</li>
          <li><b>Dutch Tilt:</b> Tension, dread, disoriented, alien glyphs, shock</li>
          <li><b>High Angle (HA):</b> Group confrontations, outnumbered, approaching danger[cite: 16]</li>
          <li><b>OTS:</b> Turn-taking dialogues, two characters facing off[cite: 17]</li>
          <li><b>Insert Shot:</b> Hand props, keys, phones, dials, notebooks, screens</li>
        </ul>
      </div>
    </div>

    <!-- Right: Generated Storyboard Flow -->
    <div>
      <div id="storyboardContainer">
        <div style="border: 2px dashed var(--line2); border-radius: 8px; padding: 40px; text-align: center; color: var(--mu);">
          Paste your script on the left and click <b>Generate Storyboard</b> to parse scenes and build your shot layout.
        </div>
      </div>
    </div>
  </div>
</main>

<div id="printSheet"></div>

